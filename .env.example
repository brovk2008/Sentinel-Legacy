# ─── Sentinel Legacy v2.0 Environment Configuration ───

# ─── Database ─────────────────────────────────────
# SQLite for zero-setup local development:
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Or PostgreSQL (Docker Compose / Production):
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel_legacy
POSTGRES_DB=sentinel_legacy
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# ─── Redis ───────────────────────────────────────
# Transparently falls back to in-memory mock if Redis is unavailable
REDIS_URL=redis://localhost:6379/0

# ─── Free LLM API Keys (Gemini & OpenRouter) ──────
# 1. Google Gemini (100% Free via Google AI Studio):
#    Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenRouter (Free tier models with :free suffix):
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Provider selection: "auto", "gemini", "openrouter", or "mock"
# When set to "auto", Sentinel uses whichever free key is provided, or mocks offline if empty.
LLM_PROVIDER=auto

# Optional paid providers (leave empty if using free keys):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── JWT & M2M Auth (RFC 8707) ───────────────────
JWT_SECRET_KEY=sentinel-legacy-hackathon-secret-32c-production-grade
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ─── Cedar Policy Paths ──────────────────────────
CEDAR_POLICIES_PATH=./sentinel/policy/policies.cedar
CEDAR_SCHEMA_PATH=./sentinel/policy/schema.cedarschema

# ─── Autonomous Trust Score Thresholds ───────────
TRUST_RESTRICTED_THRESHOLD=70
TRUST_AUTO_SUSPEND_THRESHOLD=40

# ─── Human-in-the-Loop (HITL) ────────────────────
HITL_DEFAULT_TIMEOUT_SECONDS=300
HITL_REQUIRE_RATIONALE=true
HITL_REQUIRE_CHECKBOX_ACK=true

# ─── Anomaly & Violation Thresholds ──────────────
VIOLATION_WINDOW_SECONDS=300
VIOLATION_WARNING_COUNT=2
VIOLATION_CRITICAL_COUNT=3

# ─── CORS ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── OpenTelemetry GenAI Cost Attribution ────────
COST_PER_INPUT_TOKEN_USD=0.000000
COST_PER_OUTPUT_TOKEN_USD=0.000000
