# ─── Sentinel Legacy v2.0 Environment Configuration ───

# ─── Database ─────────────────────────────────────
# For local development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# For PostgreSQL (Docker Compose / Production):
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel_legacy
POSTGRES_DB=sentinel_legacy
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# ─── Redis ───────────────────────────────────────
# Transparently falls back to in-memory mock if Redis is unavailable
REDIS_URL=redis://localhost:6379/0

# ─── JWT & M2M Auth (RFC 8707) ───────────────────
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ─── LLM Foundation Models (Optional / Mocked) ────
ANTHROPIC_API_KEY=mock-key-for-sentinel-demo
OPENAI_API_KEY=mock-key-for-sentinel-demo
GEMINI_API_KEY=mock-key-for-sentinel-demo

# ─── Cedar Policy Paths ──────────────────────────
CEDAR_POLICIES_PATH=./backend/sentinel/policy/policies.cedar
CEDAR_SCHEMA_PATH=./backend/sentinel/policy/schema.cedarschema

# ─── Autonomous Trust Score Thresholds ───────────
TRUST_RESTRICTED_THRESHOLD=70
TRUST_AUTO_SUSPEND_THRESHOLD=40

# ─── Human-in-the-Loop (HITL) ────────────────────
HITL_DEFAULT_TIMEOUT_SECONDS=300
HITL_REQUIRE_RATIONALE=true
HITL_REQUIRE_CHECKBOX_ACK=true

# ─── Anomaly & Violation Thresholds ──────────────
VIOLATION_WINDOW_SECONDS=300
VIOLATION_WARNING_COUNT=2
VIOLATION_CRITICAL_COUNT=3

# ─── CORS ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── OpenTelemetry GenAI Cost Attribution ────────
COST_PER_INPUT_TOKEN_USD=0.000003
COST_PER_OUTPUT_TOKEN_USD=0.000015
