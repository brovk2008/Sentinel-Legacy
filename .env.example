# ─── Sentinel Legacy v2.0 Production & Local Environment Configuration ───

# ─── 1. Relational Database (PostgreSQL / Neon / SQLite) ───────────
# Option A: Zero-setup local SQLite (Default for development)
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Option B: Neon Serverless Postgres (Recommended for Production - 100% Free Tier):
# Copy pooled connection string from https://console.neon.tech
# Sentinel automatically converts postgres:// to postgresql+asyncpg:// and configures SSL
# DATABASE_URL=postgresql://neondb_owner:npg_xYz@ep-cool-pooler-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option C: Local / Docker Compose PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_legacy
POSTGRES_DB=sentinel_legacy
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# Connection Pool Tuning (for Serverless Neon & Cloud DBs)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ─── 2. Cache, HITL Queue & Revocation (Redis / Upstash) ───────────
# Option A: Local Redis (or transparent InMemoryRedis fallback if unconfigured):
REDIS_URL=redis://localhost:6379/0

# Option B: Upstash Serverless Redis (Recommended for Production - 100% Free Tier):
# Copy TLS URL from https://console.upstash.com
# REDIS_URL=rediss://default:your_upstash_password@us1-cool-endpoint-12345.upstash.io:6379
REDIS_CONNECT_TIMEOUT=3.0

# ─── 3. Free Autonomous LLM API Keys (Gemini & OpenRouter) ────────
# 1. Google Gemini (100% Free via Google AI Studio - 15 RPM / 1M TPM):
#    Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenRouter (Free tier public models with :free tag):
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Provider selector: "auto" (default) | "gemini" | "openrouter" | "mock"
# When set to "auto", Sentinel uses whichever free key is provided, or mocks offline if empty.
LLM_PROVIDER=auto

# Optional paid foundation model keys (leave empty if using free keys):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── 4. JWT & M2M Auth (RFC 8707) ──────────────────────────────────
# In production, generate a cryptographically strong secret: openssl rand -hex 32
JWT_SECRET_KEY=sentinel-legacy-hackathon-secret-32c-production-grade
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ─── 5. Formal Cedar Policy Paths ─────────────────────────────────
CEDAR_POLICIES_PATH=./sentinel/policy/policies.cedar
CEDAR_SCHEMA_PATH=./sentinel/policy/schema.cedarschema

# ─── 6. Autonomous Trust Score Thresholds ──────────────────────────
TRUST_RESTRICTED_THRESHOLD=70
TRUST_AUTO_SUSPEND_THRESHOLD=40

# ─── 7. Human-in-the-Loop (HITL) Thread Suspension ────────────────
HITL_DEFAULT_TIMEOUT_SECONDS=300
HITL_REQUIRE_RATIONALE=true
HITL_REQUIRE_CHECKBOX_ACK=true

# ─── 8. Anomaly & Violation Velocity Tracker ──────────────────────
VIOLATION_WINDOW_SECONDS=300
VIOLATION_WARNING_COUNT=2
VIOLATION_CRITICAL_COUNT=3

# ─── 9. CORS Allowed Origins ───────────────────────────────────────
# In production, set to your Vercel or custom domain: https://sentinel-legacy.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── 10. OpenTelemetry GenAI Cost Attribution ─────────────────────
COST_PER_INPUT_TOKEN_USD=0.000000
COST_PER_OUTPUT_TOKEN_USD=0.000000
